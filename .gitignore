# Rebuildable runtime state (ADR-001, docs/18)
var/
/vault/

# Environments and caches
.venv/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
build/
dist/

# Local-only audit data: contains source paths (docs/22 §4). Scripts and reports stay trackable.
audit/phase0/*.csv
audit/phase0/*.jsonl
audit/phase0/samples/
audit/phase0/t2/*.csv
audit/phase0/t2/*.jsonl
audit/phase0/t3/*.csv
audit/dedup_quarantine/*.csv
audit/dedup_quarantine/*.jsonl

# Local-only generated reports and gold sets (docs/18, docs/33 §3) - anchored to the repo root so it doesn't
# also match src/sbr/reports/ (T-P2-14's report-building package, which must stay tracked).
/reports/
eval/gold/

# Local configuration (the example is tracked)
config/sbr.toml

# Session tooling
.remember/
pytest-*/
